{"name": "OTP Vault",
  "description": "Manage TOTPs with QR/image/link imports, per-authenticator identity image, countdowns, and Copy-to-Clipboard.",
  "version": "0.1.0",
  "manifest_version": 3,
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "OTP Vault"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/@icon.png",
    "32": "icons/icon32.png",
    "48": "icons/@icon.png",
    "128": "icons/@icon.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}